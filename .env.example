# =========================================================
# CyberRecon Environment Configuration
# =========================================================


# ---------------------------------------------------------
# APPLICATION SECRET
# ---------------------------------------------------------

# REQUIRED for a real production deployment.
#
# Generate a strong value using:
#
# python -c "import secrets; print(secrets.token_hex(32))"
#
# Never commit your real production secret.

CYBERRECON_SECRET_KEY=replace-with-a-long-random-production-secret


# ---------------------------------------------------------
# DEVELOPMENT MODE
# ---------------------------------------------------------

# 1 = Flask debugging enabled when using run.py
# 0 = debugging disabled

CYBERRECON_DEBUG=0


# ---------------------------------------------------------
# SESSION SECURITY
# ---------------------------------------------------------

# Use 1 only when CyberRecon is served through HTTPS.
#
# Production HTTPS:
# CYBERRECON_SECURE_COOKIES=1
#
# Local HTTP:
# CYBERRECON_SECURE_COOKIES=0

CYBERRECON_SECURE_COOKIES=1


# ---------------------------------------------------------
# HSTS
# ---------------------------------------------------------

# Enable only when the application is permanently
# available through HTTPS.

CYBERRECON_ENABLE_HSTS=1


# ---------------------------------------------------------
# SSRF / PRIVATE NETWORK POLICY
# ---------------------------------------------------------

# IMPORTANT:
#
# Production should remain:
#
# CYBERRECON_ALLOW_PRIVATE_TARGETS=0
#
# Set to 1 ONLY when running the controlled local
# CyberRecon demonstration target.

CYBERRECON_ALLOW_PRIVATE_TARGETS=0